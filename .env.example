# Example only. Do NOT put real keys in this repository.
# Real keys go in two files in your HOME folder (outside the project), readable only by you:
#   chmod 600 ~/.angel_env ~/.swing_env
#
# ~/.angel_env  (Angel One SmartAPI, for prices)
ANGEL_API_KEY=your-api-key
ANGEL_CLIENT_CODE=your-client-code
ANGEL_PIN=your-pin
ANGEL_TOTP_SECRET=your-totp-secret
#
# ~/.swing_env  (all optional)
# ANTHROPIC_API_KEY=   OPENAI_API_KEY=   GEMINI_API_KEY=      online models (off unless switched on in Settings)
# TAVILY_API_KEY=   BRAVE_API_KEY=   SERPER_API_KEY=   EXA_API_KEY=   web search for Deep search
# FRED_API_KEY=                                               macro data fallback
# TELEGRAM_BOT_TOKEN=   TELEGRAM_CHAT_ID=                     alerts
